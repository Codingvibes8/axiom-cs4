# Axiom Environment Variables Configuration Example
# Copy this file to .env.local for local Supabase integration

# Supabase Project Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Master Encryption Key Salt for Client Envelope
NEXT_PUBLIC_AXIOM_MASTER_KEY_SALT=axiom_entropy_dev_salt_2026

# Optional: AI Agent Proxy Gateway
NEXT_PUBLIC_AGENT_GATEWAY_URL=http://localhost:3000/api/agent-gateway
