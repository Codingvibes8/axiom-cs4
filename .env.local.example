# Axiom Environment Variables Configuration Example
# Copy this file to .env.local for local Supabase integration

# Supabase Project Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Google "Sign in with Google" (Supabase OAuth):
# 1. Supabase Dashboard -> Authentication -> Providers -> Google -> Enable.
#    Use the built-in default client IDs for localhost, or create credentials in
#    Google Cloud Console and paste the Client ID / Secret here.
# 2. Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs:
#    add http://localhost:3000/auth/callback (and your deployed URL + /auth/callback).
# 3. If using custom Google credentials, add Supabase's callback URL
#    (https://<project-ref>.supabase.co/auth/v1/callback) to the Google Cloud OAuth
#    app's Authorized redirect URIs.

# Optional: Master Encryption Key Salt for Client Envelope
NEXT_PUBLIC_AXIOM_MASTER_KEY_SALT=axiom_entropy_dev_salt_2026

# Optional: AI Agent Proxy Gateway
NEXT_PUBLIC_AGENT_GATEWAY_URL=http://localhost:3000/api/agent-gateway
