# Axiom Environment Variables Configuration Example
# Copy this file to .env.local for local development.

# Supabase Project Connection (required for real authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Demo Mode
# When true, unauthenticated demo logins are enabled and all data stays in
# browser memory. NEVER enable this on a deployment that holds real secrets.
# Local development (next dev) enables demo mode automatically only when
# Supabase is not configured and this flag is unset.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: AI Agent Proxy Gateway
NEXT_PUBLIC_AGENT_GATEWAY_URL=http://localhost:3000/api/agent-gateway
